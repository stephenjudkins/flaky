    ],
    "builder": "/nix/store/ki4g5pbmqcs07mwrxmvik6dpnzyx3z4c-bootstrap-tools/bin/bash",
    "env": {
      "__structuredAttrs": "",
      "am_cv_func_iconv_works": "yes",
      "buildInputs": "/nix/store/nd2whz5navl1kf7ydnw5wb925vpi1fhr-bash-5.3p15-dev",
      "builder": "/nix/store/ki4g5pbmqcs07mwrxmvik6dpnzyx3z4c-bootstrap-tools/bin/bash",
      "cmakeFlags": "",
      "configureFlags": "--disable-csharp",
