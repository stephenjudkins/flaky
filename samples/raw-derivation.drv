      "pname": "bootstrap-stage4-gcc-wrapper",
      "postFixup": "touch \"$out/nix-support/cc-cflags\"\ntouch \"$out/nix-support/cc-ldflags\"\nif [[ -f \"$bintools/nix-support/dynamic-linker\" ]]; then\n  ln -s \"$bintools/nix-support/dynamic-linker\" \"$out/nix-support\"\nfi\nif [[ -f \"$bintools/nix-support/dynamic-linker-m32\" ]]; then\n  ln -s \"$bintools/nix-support/dynamic-linker-m32\" \"$out/nix-support\"\nfi\necho \"-L/nix/store/wqqb6mbnrnm380adc0ry5hdm449xix4f-gcc-15.3.0/lib/gcc/aarch64-unknown-linux-gnu/15.3.0\" >> $out/nix-support/cc-ldflags\necho \"-L/nix/store/ylzalvsf8nxhidm1p72k6ckxckpj1wd3-gcc-15.3.0-lib/lib\" >> $out/nix-support/cc-ldflags\ntouch \"$out/nix-support/libc-cflags\"\ntouch \"$out/nix-support/libc-ldflags\"\necho \"-B/nix/store/f8q4w2hbjvwy7qqwpnvbf5f4qwyww6cp-glibc-2.42-67/lib/\" >> $out/nix-support/libc-crt1-cflags\ninclude \"-idirafter\" \"/nix/store/cwn32dkv1iffrhh6sw1gk09nxb10dv17-glibc-2.42-67-dev/include\" >> $out/nix-support/libc-cflags\nfor dir in \"/nix/store/wqqb6mbnrnm380adc0ry5hdm449xix4f-gcc-15.3.0\"/lib/gcc/*/*/include-fixed; do\n  include '-idirafter' ${dir} >> $out/nix-support/libc-cflags\ndone\n\necho \"/nix/store/f8q4w2hbjvwy7qqwpnvbf5f4qwyww6cp-glibc-2.42-67\" > $out/nix-support/orig-libc\necho \"/nix/store/cwn32dkv1iffrhh6sw1gk09nxb10dv17-glibc-2.42-67-dev\" > $out/nix-support/orig-libc-dev\ntouch \"$out/nix-support/libcxx-cxxflags\"\ntouch \"$out/nix-support/libcxx-ldflags\"\nccLDFlags=()\nccCFlags=()\nif [ -e \"/nix/store/ylzalvsf8nxhidm1p72k6ckxckpj1wd3-gcc-15.3.0-lib/lib64\" -a ! -L \"/nix/store/ylzalvsf8nxhidm1p72k6ckxckpj1wd3-gcc-15.3.0-lib/lib64\" ]; then\n  ccLDFlags+=(\"-L/nix/store/ylzalvsf8nxhidm1p72k6ckxckpj1wd3-gcc-15.3.0-lib/lib64\")\n  ccCFlags+=(\"-B/nix/store/ylzalvsf8nxhidm1p72k6ckxckpj1wd3-gcc-15.3.0-lib/lib64\")\nfi\nccLDFlags+=(\"-L/nix/store/ylzalvsf8nxhidm1p72k6ckxckpj1wd3-gcc-15.3.0-lib/lib\")\nccCFlags+=(\"-B/nix/store/ylzalvsf8nxhidm1p72k6ckxckpj1wd3-gcc-15.3.0-lib/lib\")\n\necho \"${ccLDFlags[*]}\" >> $out/nix-support/cc-ldflags\necho \"${ccCFlags[*]}\" >> $out/nix-support/cc-cflags\nln -s /nix/store/khblf98c721xyd5j9hphmii437bh2qdy-gcc-15.3.0-man $man\nln -s /nix/store/qrxx8zzs0ixlair4lvj8gmnaalaapcmf-gcc-15.3.0-info $info\nexport hardening_unsupported_flags=\"shadowstack\"\necho \"-fno-omit-frame-pointer -mno-omit-leaf-frame-pointer\" >> $out/nix-support/cc-cflags-before\nprintf \"%s\\n\" '-march=armv8-a' >> $out/nix-support/cc-cflags-before\nfor flags in \"$out/nix-support\"/*flags*; do\n  substituteInPlace \"$flags\" --replace-quiet $'\\n' ' '\ndone\n\nsubstituteAll /nix/store/vwddwz286f9smq4i2lrnqsyc256lqwdk-add-flags.sh $out/nix-support/add-flags.sh\nsubstituteAll /nix/store/lp2nnib5zm4vl8ydz81yns04vzyxw926-add-hardening.sh $out/nix-support/add-hardening.sh\nsubstituteAll /nix/store/6b9v7v02npab086yaba2j4yfqrph5mgp-utils.bash $out/nix-support/utils.bash\nsubstituteAll /nix/store/6xizqkp4bnhydwc7ihyqi93171gbj5n4-darwin-sdk-setup.bash $out/nix-support/darwin-sdk-setup.bash\n",
