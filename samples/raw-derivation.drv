\"${ccCFlags[*]}\" >> $out/nix-support/cc-cflags\nln -s /nix/store/khblf98c721xyd5j9hphmii437bh2qdy-gcc-15.3.0-man $man\nln -s /nix/store/qrxx8zzs0ixlair4lvj8gmnaalaapcmf-gcc-15.3.0-info $info\nexport hardening_unsupported_flags=\"shadowstack\"\necho \"-fno-omit-frame-pointer -mno-omit-leaf-frame-pointer\" >> $out/nix-support/cc-cflags-before\nprintf \"%s\\n\" '-march=armv8-a' >> $out/nix-support/cc-cflags-before\nfor flags in \"$out/nix-support\"/*flags*; do\n  substituteInPlace \"$flags\" --replace-quiet $'\\n' ' '\ndone\n\nsubstituteAll /nix/store/vwddwz286f9smq4i2lrnqsyc256lqwdk-add-flags.sh $out/nix-support/add-flags.sh\nsubstituteAll /nix/store/lp2nnib5zm4vl8ydz81yns04vzyxw926-add-hardening.sh $out/nix-support/add-hardening.sh\nsubstituteAll /nix/store/6b9v7v02npab086yaba2j4yfqrph5mgp-utils.bash $out/nix-support/utils.bash\nsubstituteAll /nix/store/6xizqkp4bnhydwc7ihyqi93171gbj5n4-darwin-sdk-setup.bash $out/nix-support/darwin-sdk-setup.bash\n",
