/store/m9qvr6m0bylrjqb5ind6hfzsax14xys9-gnu-binutils-strip-wrapper.sh \\\n  \"/nix/store/ki4g5pbmqcs07mwrxmvik6dpnzyx3z4c-bootstrap-tools/bin/strip\"\nfor flags in \"$out/nix-support\"/*flags*; do\n  substituteInPlace \"$flags\" --replace $'\\n' ' '\ndone\n\nsubstituteAll /nix/store/mrzpfh0ml9k07sw019ydagbb2z1q4sxz-add-flags.sh $out/nix-support/add-flags.sh\nsubstituteAll /nix/store/8fhj67p4n5lcp9lkl19vdcrlcbl3jcsi-add-hardening.sh $out/nix-support/add-hardening.sh\nsubstituteAll /nix/store/6b9v7v02npab086yaba2j4yfqrph5mgp-utils.bash $out/nix-support/utils.bash\nsubstituteAll /nix/store/6xizqkp4bnhydwc7ihyqi93171gbj5n4-darwin-sdk-setup.bash $out/nix-support/darwin-sdk-setup.bash\n",
